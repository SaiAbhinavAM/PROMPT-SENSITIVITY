# =============================================================================
# .env.example — single place for keys + model/role config.
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored (secrets never committed); .env.example is the template.
#
# Loaded automatically by prompt_robustness (python-dotenv). The H100 runners
# also `source` this file so gensens / vLLM / huggingface-cli see HF_TOKEN.
# =============================================================================

# --- Secrets ---------------------------------------------------------------
# HuggingFace token (accept the Llama/Qwen/Mistral licenses on hf.co first).
# Needed to DOWNLOAD gated weights on the box. Not an inference API key.
HF_TOKEN=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

# --- Phase 2 models under test (comma-separated; read by config.py) --------
# The 3 cross-family 8B subjects whose robustness is benchmarked.
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct,Qwen/Qwen2.5-7B-Instruct,mistralai/Mistral-7B-Instruct-v0.3,hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4

# --- Decoding (deterministic by default; R2) -------------------------------
DO_SAMPLE=false
SEED=42
MAX_NEW_TOKENS=200

# --- Scoring instruments (independent of the subjects; R5/R3) --------------
# Embedder for SMS / CS / TRD. Laptop: all-MiniLM-L6-v2. H100: gte-Qwen2-7B.
EMBEDDER_MODEL=BAAI/bge-large-en-v1.5

# Judge (Human_Score). 70B-AWQ is independent of the 8B subjects (no self-eval).
JUDGE_MODEL=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4
JUDGE_QUANTIZATION=awq_marlin

# Faithfulness: "llm" = LLM-as-NLI on the model below; "nli" = local deberta.
FAITHFULNESS_BACKEND=llm
FAITHFULNESS_MODEL=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4

# Shared causal backend: "auto" (vLLM, fallback HF), "vllm", or "hf".
LLM_BACKEND=auto
LLM_QUANTIZATION=awq_marlin

# --- Phase 1 generator (also settable via generate_dataset.py CLI flags) ---
GENERATOR_MODEL=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4
GENERATOR_QUANTIZATION=awq_marlin
